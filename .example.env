# Server's URL.
HIREVEC_URL=https://localhost:6969

# Log level.
# Valid values are debug, info, warn, error.
HIREVEC_LOG_LEVEL=info

# Produce logs in JSON format.
HIREVEC_LOG_JSON=false

# Request read timeout.
# Valid time units are "ns", "us", "ms", "s", "m", "h".
HIREVEC_REQUEST_READ_TIMEOUT=1s

# Request write timeout.
# Valid time units are "ns", "us", "ms", "s", "m", "h".
HIREVEC_REQUEST_WRITE_TIMEOUT=1s

# Graceful server shutdown period.
# Valid time units are "ns", "us", "ms", "s", "m", "h".
HIREVEC_GRACE_PERIOD=5s

# Embeddings job frequency.
# Valid time units are "ns", "us", "ms", "s", "m", "h".
HIREVEC_EMBEDDINGS_JOB_FREQUENCY=1h

# Recommendations job frequency.
# Valid time units are "ns", "us", "ms", "s", "m", "h".
HIREVEC_RECOMMENDATIONS_JOB_FREQUENCY=12h

# llama-cpp server URL.
HIREVEC_LLAMACPP_URL=http://localhost:9931

# Path to the llama-cpp server API key.
HIREVEC_LLAMACPP_API_KEY_FILE=

# llama-cpp embeddings model.
HIREVEC_LLAMACPP_EMBEDDINGS_MODEL=jinaai/jina-embeddings-v5-text-nano-retrieval-GGUF:Q8_0

# llama-cpp reranker model.
HIREVEC_LLAMACPP_RERANKER_MODEL=mradermacher/jina-reranker-v1-tiny-en-GGUF:Q8_0

# Embeddings dimensionality.
HIREVEC_LLAMACPP_EMBEDDINGS_DIM=768

# Path to the symmetric key file for refresh token encryption.
# Auto-generated and stored in ~/.hirevec/.symkey.txt when missing.
HIREVEC_SYMMETRIC_KEY_FILE=

# Path to the asymmetric key for access token signing.
# Auto-generated and stored in ~/.hirevec/.asymkey.txt when missing.
HIREVEC_ASYMMETRIC_KEY_FILE=

# TLS-related config.
HIREVEC_TLS_ENABLED=false

# Path to the TLS certificate file.
HIREVEC_TLS_CERT_FILE=

# Path to the TLS certificate key.
HIREVEC_TLS_KEY_FILE=

# Path to the API key file.
# The API key requirement is enabled when the file exists and is non-empty.
HIREVEC_API_KEY_FILE=

# Set to true when the server runs behind a trusted reverse proxy that appends
# to X-Forwarded-For; client IPs are then read from that header.
HIREVEC_TRUSTED_PROXY=false

# WebAuthn relying party display name.
# Shown to users in the browser's passkey prompts.
HIREVEC_WEBAUTHN_RP_DISPLAY_NAME=Hirevec

# WebAuthn relying party ID.
# Defaults to the host of HIREVEC_URL.
HIREVEC_WEBAUTHN_RPID=

# Comma-separated WebAuthn relying party origins.
# Defaults to the scheme and host of HIREVEC_URL.
HIREVEC_WEBAUTHN_RP_ORIGINS=
